# Firebase Configuration (Next.js Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeApiKeyForDocumentationOnly12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fairwork-demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fairwork-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fairwork-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Toggle Emulator Local (true jika ingin otomatis connect ke emulator saat dev)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Firebase Admin SDK Configuration (Node.js API)
# Paste string JSON Service Account secara inline (jangan komit file asli!)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"fairwork-demo","private_key_id":"dummy_id","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@fairwork-demo.iam.gserviceaccount.com","client_id":"dummy_client_id"}

# Server Config
PORT=5000
NODE_ENV=development
