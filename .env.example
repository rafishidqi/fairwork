# ==============================================================================
# FairWork Environment Variables (Versi 1.1 - Supabase)
# ==============================================================================

# Supabase Public API (Accessible by client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser!)
# Used strictly for automated admin migration scripts and seed utilities
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Application URL for production redirects & OAuth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
