rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Memverifikasi apakah pengguna saat ini adalah anggota proyek melalui Cloud Firestore
    function isProjectMember(projectId) {
      let projectPath = /databases/(default)/documents/projects/$(projectId);
      return isAuthenticated() &&
        firestore.exists(projectPath) &&
        request.auth.uid in firestore.get(projectPath).data.memberIds;
    }

    // Batas ukuran file maksimal 10 MB (10 * 1024 * 1024 = 10485760 bytes)
    function isValidSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // File yang diizinkan: PDF, DOCX, DOC, TXT, PNG, JPG/JPEG
    function isValidContentType() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document')
        || request.resource.contentType.matches('application/msword')
        || request.resource.contentType.matches('text/plain.*')
        || request.resource.contentType.matches('image/png')
        || request.resource.contentType.matches('image/jpeg');
    }

    // Path bukti tugas / submission: projects/{projectId}/milestones/{milestoneId}/...
    match /projects/{projectId}/milestones/{milestoneId}/{allPaths=**} {
      // Hanya anggota proyek yang bisa mengunduh / membaca file
      allow read: if isProjectMember(projectId);

      // Anggota proyek dapat mengunggah file baru (resource == null memastikan file baru, mencegah overwrite)
      allow create: if resource == null && isProjectMember(projectId) && isValidSize() && isValidContentType();

      // File bukti submission bersifat immutable (tidak boleh di-overwrite atau dihapus sembarangan oleh klien)
      allow update, delete: if false;
    }

    // Default deny untuk path selain pola di atas
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
